Algoritmo Ejercicio7
	//Confeccionar un programa que sume dos numeros y nos muestre el resultado
	
	//Definir variables
	Definir num1, num2, resultado Como real;
	
	//Entrada de datos
	Escribir ("Ingrese el primer numero: ");
	Leer num1;
	Escribir ("Ingrese el segundo numero: ");
	Leer num2;
	
	//Proceso
	resultado<-num1+num2;
	
	//Salida de datos
	Escribir "El resultado es : ",resultado;
	
FinAlgoritmo
